    <Window x:Class="TasbeehApp.HudWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="Tasbeeh HUD" Height="Auto" Width="Auto"
            WindowStyle="None"
            Topmost="True"
            AllowsTransparency="True"
            Background="Transparent"
            ResizeMode="NoResize"
            ShowInTaskbar="False">

        <Grid Margin="10">
            <Border Background="#66000000" 
                    CornerRadius="8" 
                    Padding="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MaxWidth="400"
                    >
                <TextBlock x:Name="DisplayText"
                        FontSize="16"
                        Foreground="White"
                        TextWrapping="Wrap"
                        TextAlignment="Right"
                        FlowDirection="RightToLeft"
                        LineHeight="22"
                        />
            </Border>
        </Grid>
    </Window>
