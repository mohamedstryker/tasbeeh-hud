<Window x:Class="TasbeehApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات التسبيح"
        Height="340" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2F"
        Foreground="#DDDDDD"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <!-- Resources -->
    <Window.Resources>
        <!-- ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#2E2E3E">
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Background="#4CAF50" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Background" Value="#2E2E3E"/>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Background" Value="#2E2E3E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3C3C4E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Text="إعدادات التسبيح"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   Foreground="#FFFFFF"/>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="اختر مجموعة أذكار:" FontSize="14" Margin="0,0,0,4"/>
                <ComboBox x:Name="PresetBox"
                          FontSize="13"
                          SelectionChanged="PresetBox_SelectionChanged"
                          Padding="4" Margin="0,0,0,10">
                    <ComboBoxItem Content="تسابيح عامة"/>
                    <ComboBoxItem Content="أذكار الصباح"/>
                    <ComboBoxItem Content="أذكار المساء"/>
                    <ComboBoxItem Content="مخصص"/>
                </ComboBox>


                <TextBlock Text="الكلمة / الذكر:" FontSize="14" Margin="0,0,0,4"/>
                <TextBox x:Name="PhraseBox"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontSize="13"
                         Padding="6"
                         Background="#2E2E3E"
                         Foreground="#DDDDDD"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,10"/>


                <TextBlock Text="Hotkey (مثلاً: Z):" FontSize="14" Margin="0,0,0,4"/>
                <TextBox x:Name="HotkeyBox"
                         FontSize="13"
                         Padding="4"
                         Width="80"
                         Background="#2E2E3E"
                         Foreground="#DDDDDD"
                         BorderThickness="0"/>
            </StackPanel>
        </ScrollViewer>


        <Button Content="ابدأ التسبيح"
                Grid.Row="2"
                Height="36"
                Margin="0,15,0,0"
                Background="#4CAF50"
                Foreground="White"
                FontSize="14"
                Click="Start_Click"
                HorizontalAlignment="Center"
                Width="180"
                BorderThickness="0"
                Cursor="Hand"/>
    </Grid>
</Window>
